{
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Bash",
      "PowerShell"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(rm -fr:*)",
      "Bash(rm -r:*)",
      "Bash(rm -f:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(git checkout .:*)",
      "PowerShell(Remove-Item -Recurse -Force:*)",
      "PowerShell(Remove-Item -Recurse:*)",
      "PowerShell(Remove-Item -Force:*)",
      "PowerShell(git push --force:*)",
      "PowerShell(git reset --hard:*)"
    ]
  }
}

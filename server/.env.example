PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/pte_ai_portal
# Required. Must be at least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars
CLIENT_URL=http://localhost:5173
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
SUBSCRIPTION_DEFAULT_DAYS=30

# Set both of these, start the server once to create the first admin account, then clear the password.
ADMIN_USERNAME=
ADMIN_PASSWORD=

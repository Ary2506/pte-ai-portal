PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/pte_ai_portal
# Required. Must be at least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars
CLIENT_URL=http://localhost:5173
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Days a student recording is kept. Must match the R2 lifecycle rule on recordings/ (0 = forever).
RECORDING_RETENTION_DAYS=7
# Lets Share show an answer's existing link again instead of making a new one. A long random value,
# e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Unset, every Share makes a new link (as before). Changing it only stops older links being reused.
SHARE_LINK_SECRET=
SUBSCRIPTION_DEFAULT_DAYS=30

# Set both of these, start the server once to create the first admin account, then clear the password.
ADMIN_USERNAME=
ADMIN_PASSWORD=
